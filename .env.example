# 复制为根目录 .env 后填写。此文件被 gitignore，切勿提交真实密钥。

# 必填：模型密钥（Agent / 写文章依赖）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 必填：公网访问口令（nginx Basic Auth，整站生效）
CAMPUS_BASIC_USER=admin
CAMPUS_BASIC_PASSWORD=please-change-me

# 可选：对外端口，默认 8080
CAMPUS_HTTP_PORT=8080

# 可选：本地语义检索，off = 只用 BM25，不下载约 95MB ONNX 模型
CAMPUS_EMBEDDING=auto
CAMPUS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# 可选：后端 CORS 白名单（逗号分隔）。留空=同源部署下保持默认。
CAMPUS_ALLOW_ORIGINS=
