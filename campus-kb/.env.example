# 复制为 .env 后填入真实密钥（.env 已 gitignore，不会入库）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：模型名与接口地址，保持默认即可
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：本地语义检索（api/rag.py）
# 留空/不填 = 自动启用；首次使用会下载约 95MB 的 ONNX 中文模型到本机缓存
# 设为 off 则只用 BM25 关键词检索，功能不挂、无需下载任何模型
CAMPUS_EMBEDDING=auto
# 模型名（fastembed 支持的中文模型）
CAMPUS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 模型下载源；国内直连 HuggingFace 不通时用镜像
HF_ENDPOINT=https://hf-mirror.com
