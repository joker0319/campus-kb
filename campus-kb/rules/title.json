    {
      "id": "TITLE-002",
      "category": "头衔",
      "severity": "info",
      "type": "forbid_pattern",
      "desc": "不得使用规范手册职务对照表未收录的职务变体",
      "params": {
        "pattern": "(常务副校长|常务执行校长|第一副校长)",
        "message": "该职务写法未见于规范手册职务对照表，请核对官网 leadership 页面"
      },
      "suggestion": "以 https://www.cityu-dg.edu.cn/zh/leadership.html 为准"
    }
  ]
