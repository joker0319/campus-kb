      "params": {
        "window": 45,
        "people": [
          { "name": "段宝岩", "must_near": ["校长"] },
          { "name": "鲁春", "must_near": ["执行校长"] },
          { "name": "李娟", "must_near": ["副校长（学术）", "副校长(学术)"] },
          { "name": "刘子顺", "must_near": ["副校长（研究与创新）", "副校长(研究与创新)"] },
          { "name": "赵志裕", "must_near": ["副校长（行政）", "副校长(行政)"] },
          { "name": "程军祥", "must_near": ["协理副校长（运维）", "协理副校长(运维)"] },
          { "name": "李远", "must_near": ["协理副校长（教学与发展）", "协理副校长(教学与发展)"] }
        ]
      },
      "suggestion": "首次出现用「职务全称 + 姓名」，后文可用「职务简称 + 姓名」或「姓 + 职务」"
